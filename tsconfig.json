{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": false
  },
  "exclude": [
    "examples/**",
    "site/**",
    "**/node_modules/**",
    "test-project/typescript-5-7.test-d.ts",
    "test-project/graphql-16/**"
  ]
}
