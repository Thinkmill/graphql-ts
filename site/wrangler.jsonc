{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "graphql-ts-docs",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "graphql-ts.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
